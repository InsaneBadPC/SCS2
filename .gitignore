# Edge Function bundles (generated by scripts/bundle-edge-functions.mjs)
supabase/functions-dist/

# Stray root deno.lock. The only legitimate deno lockfile is the tracked
# supabase/functions/deno.lock; a root one is generated when `deno check` /
# `deno bundle` is run from the repo root instead of from supabase/functions
# (which is why bundle-edge-functions.mjs sets cwd = supabase/functions), and it
# snapshots the root package.json into a bogus workspace member. CI runs
# `deno check --config supabase/functions/deno.json --no-lock`, so it never
# reads a lockfile and must never be committed.
/deno.lock

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json
.manus/
.manus-logs/
dist-web/
