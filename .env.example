# ─────────────────────────────────────────────────────────────────
# .env.example — ŠABLONA. NEPIŠ SEM ŽÁDNÉ SKUTEČNÉ HODNOTY.
# ─────────────────────────────────────────────────────────────────
# Zkopíruj do lokálního souboru a ten vyplň:
#
#   cp .env.example .env.local
#
# .env.local musí zůstat necommitnutý. Všechny hodnoty patří do
# gitignorovaného `SCS2/.env.scs2.local` (viz PROVISIONOVANI.md § 0).
# Zdroj pravdy pro seznam jmen je `SCS2/.env.scs2.example` — když
# se jména rozcházejí, je pravda tam.
#
# Zdrojové repo tohoto souboru: legacy copy `.env.example`. Originál
# v tomhle repu chyběl, přestože README na řádku 23 instruuje
# `cp .env.example .env.local` (audit nález č. 6).

# ── Supabase — klíče nového projektu ────────────────────────────
# Dashboard → Project Settings → API Keys
# Hodnoty NEJSOU tajemství (kromě service_role) a patří do GitHub
# Variables `SUPABASE_URL` / `SUPABASE_ANON_KEY`.
SUPABASE_URL=
# publishable (sb_publishable_…) nebo starší anon (eyJ…) klíč.
# Stejnou hodnotu dostane i SONGCRAFT_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# ⚠️ TOTO JE TAJEMSTVÍ. Obchází RLS. Nikdy do repa, nikdy do klienta.
# Jen pro edge funkce, video-renderer, ops-runner a provision skripty.
SUPABASE_SERVICE_ROLE_KEY=

# ── Allowlist přístupu (fail-closed bezpečnostní politika) ────────
# UUID tří nových účtů, která vrátí provision-private-accounts.mjs.
# → supabase secrets set + GitHub Secrets
SONGCRAFT_ALLOWED_USER_IDS=
# Tři REÁLné, doručitelné e-maily — ne @songcraft.test.
# Které to jsou: PROVISIONOVANI.md § 5 Rozhodnutí 2 → 2.1.
# Prázdné = 403 = app vypadá prázdná.
SONGCRAFT_ALLOWED_EMAILS=

# ── Google AI Studio ─────────────────────────────────────────────
# https://aistudio.google.com → Get API key → Create API key
# ⚠️ TAJEMSTVÍ. Čtou ho songcraft-copywriter, songcraft-rhymes,
# songcraft-studio-assistant a agent-orchestrator (jako PROVIDERS[0]).
GOOGLE_AI_STUDIO_KEY=

# ── YouTube OAuth ─────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# ⚠️ KLIENT MUSÍ BÝT TYPU "WEB APPLICATION" (Webová aplikace).
#    "Desktop app" nepřijímá https redirect URI — pouze loopback
#    (http://localhost), takže by každý pokus skončil redirect_uri_mismatch.
# Klienta vytváří majitel; kódem to udělat nejde.
# Postup krok za krokem: docs/YOUTUBE_OAUTH_RUNBOOK.md
YOUTUBE_CLIENT_ID=
# ⚠️ TAJEMSTVÍ. Credentials → tvůj klient
YOUTUBE_CLIENT_SECRET=
# https://<REF>.supabase.co/functions/v1/youtube-oauth-callback
# Musí být ZNAK PO ZNAKU stejná jako v Authorized redirect URIs u klienta.
YOUTUBE_REDIRECT_URI=
# Vlastní deep-link scheme do aplikace. Hodnota je
# `songcraftstudio://settings` — zapiš ji do řádku níže.
SONGCRAFT_APP_REDIRECT_URL=
# Táž hodnota, ale s EXPO_PUBLIC_ prefixem → jde do klientského
# buildu, takže sem nesmí nikdy nic jiného než necitlivý redirect.
EXPO_PUBLIC_YOUTUBE_OAUTH_REDIRECT_URL=

# ── Cron secrety (edge funkce bez JWT) ────────────────────────────
# Vymysli si dva různé, dlouhé, náhodné řetězce. Tyhle funkce se
# volají cronem a ověřují hlavičku x-cron-secret.
# Vymyslíš si je sám; do .env.local jen zkopíruj.
SYNC_STATS_CRON_SECRET=
PUBLISH_SCHEDULER_SECRET=
